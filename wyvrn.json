{
  "name": "CLI11",
  "version": "2.6.2.0",
  "schemaVersion": 2,
  "kind": "HeaderOnlyLib",
  "description": "Command line parser for C++11 and beyond; header-only, single-file, feature-rich with subcommands, flags, options, and config file support",
  "dependencies": {},
  "build": {
    "system": "cmake",
    "generator": [
      "Ninja Multi-Config",
      "Visual Studio 17 2022",
      "Visual Studio 16 2019"
    ],
    "configs": [
      "Debug",
      "Release",
      "RelWithDebInfo",
      "MinSizeRel"
    ],
    "configure": [
      "-DCLI11_BUILD_TESTS=OFF",
      "-DCLI11_BUILD_EXAMPLES=OFF"
    ],
    "installDir": "install"
  },
  "compatibility": {
    "os": "exact",
    "arch": "exact",
    "compiler": "exact",
    "compiler.version": "exact-or-newer",
    "compiler.cppstd": "exact-or-newer",
    "compiler.runtime": "exact"
  }
}
